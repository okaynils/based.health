---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProtocols = await getCollection('protocols');
const categories = [...new Set(allProtocols.map(p => p.data.goal))];
---

<BaseLayout title="based.health - Open Source Health Protocols">
	<!-- What & Motivation -->
	<div class="mt-4 px-4 py-1 bg-stone-100 border border-stone-200">
		<p class="py-2">
			<b>based.health</b> is an open-source collection of health protocols, meals, and products designed to improve energy, longevity, fitness, and mental clarity. Health information is scattered with numerous sources like the Huberman Lab podcast, Bryan Johnson's Blueprint, and specialized clinical research.
		</p>
		<p class="py-2">
			The goal of this project is to bring these sources together into one community-managed directory, without any marketing or ads.
		</p>
		<p class="py-2">
			Contribute on <a href="https://github.com/okaynils/based.health" target="_blank">github</a>!
		</p>
	</div>

    <main class="py-4">
		<h3 class="font-bold text-pink-800 uppercase text-sm">Protocols</h3>
        <div class="gap-8 my-2">
            {categories.map(cat => (
                <div class="category">
                    <ul>
                        {allProtocols.filter(p => p.data.goal === cat).map(p => (
                            <a href={`/protocols/${p.id}`} class="ml-1">
								<li class="text-sm border-b border-dashed">
									<span class="text-gray-400 text-xs italic">new</span>
										{p.data.title}
								</li>
                            </a>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
		<h3 class="font-bold text-sky-800 mb-2 uppercase text-sm">Products</h3>
		<h3 class="font-bold text-green-800 mb-2 uppercase text-sm">Meals</h3>
    </main>
</BaseLayout>