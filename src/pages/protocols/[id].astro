---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const protocols = await getCollection('protocols');
  return protocols.map(protocol => ({
    params: { id: protocol.id },
    props: { protocol },
  }));
}

const { protocol } = Astro.props;
const { Content } = await render(protocol);
---

<BaseLayout title={`${protocol.data.title} - based.health`}>
    <main class="mt-24 px-4">
        <nav class="mb-8 text-xs">
            <a href="/" class="text-gray-500 underline">← back to directory</a>
        </nav>

        <header class="mb-8">
            <p class="text-[10px] uppercase text-[#a64d79] font-bold mb-1">
                Category: {protocol.data.goal}
            </p>
            <h1 class="text-3xl font-bold leading-tight">{protocol.data.title}</h1>
        </header>

        <article class="prose prose-sm max-w-none pb-20">
            <Content />
        </article>

        <div class="bg-[#ffffee] border border-[#eee] p-4 text-xs">
            <strong>Contribute:</strong> See a mistake? Edit this protocol on 
            <a href="https://github.com/okaynils/based.health">GitHub</a>.
        </div>
    </main>
</BaseLayout>