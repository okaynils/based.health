---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const protocols = await getCollection("protocols");
    return protocols.map((protocol) => ({
        params: { id: protocol.id.replace(/\.md$/, "") },
        props: { protocol },
    }));
}

const { protocol } = Astro.props;
const { Content } = await render(protocol);
---

<BaseLayout title={`${protocol.data.title} - based.health`}>
    <main class="py-4">
        <header class="mb-4">
            <h2 class="text-2xl font-bold text-stone-900 leading-none">
                {protocol.data.title}
            </h2>
            <p class="text-sm text-stone-600 leading-relaxed mt-2">
                {protocol.data.summary}
            </p>
        </header>

        <div class="protocol-layout">
            <article class="prose-container max-w-none">
                <Content />
            </article>

            <aside class="protocol-infobox">
                <h3>Snapshot</h3>
                <dl>
                    <div><dt>Time</dt><dd>{protocol.data.timeCommitment}</dd></div>
                    <div><dt>Frequency</dt><dd>{protocol.data.frequency}</dd></div>
                    <div><dt>Cost</dt><dd>{protocol.data.cost}</dd></div>
                    <div><dt>Difficulty</dt><dd>{protocol.data.difficulty}</dd></div>
                    <div><dt>Evidence</dt><dd>{protocol.data.evidenceLevel}</dd></div>
                    <div><dt>Risk</dt><dd>{protocol.data.riskLevel}</dd></div>
                    <div><dt>Verified</dt><dd>{protocol.data.lastUpdated.toISOString().split("T")[0]}</dd></div>
                </dl>
                <div class="mt-2 flex flex-wrap gap-1">
                    {protocol.data.tags.map((tag) => <span class="meta-chip">#{tag}</span>)}
                </div>
                <div class="mt-3 border-t border-stone-300 pt-2">
                    <h4 class="font-bold text-[11px] uppercase text-stone-600 mb-1">Modify or avoid</h4>
                    <ul class="list-disc ml-4 space-y-1 text-xs leading-snug text-stone-700">
                        {protocol.data.contraindications.map((item) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                </div>
            </aside>
        </div>

        <aside class="mt-6 border-t border-stone-300 pt-2 text-xs leading-relaxed text-stone-500">
            This is a general education protocol, not personal medical advice. Stop if symptoms feel unsafe, and use qualified medical guidance for diagnosed conditions, medications, pregnancy, or high-risk situations.
        </aside>
    </main>
</BaseLayout>

<style is:global>
    @reference "../../styles/global.css";
  
    .prose-container {
      @apply text-stone-800 leading-relaxed text-[14px];
    }

    .protocol-layout {
      @apply grid gap-5;
    }

    .protocol-infobox {
      @apply border border-stone-300 bg-stone-100 p-2 text-xs text-stone-800 h-fit;
    }

    .protocol-infobox h3 {
      @apply font-bold text-sm text-stone-900 mb-2 border-b border-stone-300 pb-1;
    }

    .protocol-infobox dl {
      @apply grid gap-0;
    }

    .protocol-infobox dl div {
      @apply grid grid-cols-[5.5rem_1fr] gap-2 border-b border-stone-300 py-1.5 last:border-b-0;
    }

    .protocol-infobox dt {
      @apply font-bold text-[11px] uppercase text-stone-500;
    }

    .protocol-infobox dd {
      @apply text-stone-800 capitalize;
    }

    @media (min-width: 860px) {
      .protocol-layout {
        grid-template-columns: minmax(0, 1fr) 18rem;
        align-items: start;
      }

      .protocol-infobox {
        position: sticky;
        top: 1rem;
        order: 2;
      }
    }
  
    /* --- 1. Lists --- */
    .prose-container ul { @apply !list-disc !list-outside !mb-4 !ml-5 !block; }
    .prose-container ol { @apply !list-decimal !list-outside !mb-4 !ml-5 !block; }
    .prose-container li { @apply !mb-1.5 !pl-1; }
  
    /* --- 2. IEEE Citations --- */
    .prose-container sup { @apply !relative !align-baseline !top-0; }
    .prose-container sup a { @apply !no-underline text-blue-700 font-mono text-sm mx-0.5; }
    .prose-container sup a::before { content: "["; }
    .prose-container sup a::after { content: "]"; }
  
    /* --- 3. Headers & Paragraphs --- */
    .prose-container h3 {
      @apply text-lg font-serif font-bold pb-1 mt-5 mb-2 text-stone-900 border-b border-stone-300;
    }
    .prose-container p { @apply mb-4; }
  
    /* --- 4. The References Section (Footnotes) --- */
    .prose-container .footnotes {
        @apply mt-0 pt-0 border-none; /* Remove default spacing/borders */
        counter-reset: footnotes-counter;
    }

    .prose-container .footnotes h2, 
    .prose-container .footnotes [data-footnote-label] {
        @apply !hidden;
    }

    .prose-container .footnotes ol { @apply !list-none !ml-0 !p-0 !mt-4; }
    .prose-container .footnotes li { @apply text-sm text-stone-600 mb-4 flex items-start gap-3; }

    .prose-container .footnotes li::before {
        counter-increment: footnotes-counter;
        content: "[" counter(footnotes-counter) "]";
        @apply font-mono text-stone-400 shrink-0 min-w-[25px] text-right;
    }

    .prose-container .footnotes li p { @apply !m-0 !inline; }
    .prose-container .data-footnote-backref { @apply !hidden; }
</style>
