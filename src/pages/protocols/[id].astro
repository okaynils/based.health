---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const protocols = await getCollection("protocols");
    return protocols.map((protocol) => ({
        params: { id: protocol.id.replace(/\.md$/, "") },
        props: { protocol },
    }));
}

const { protocol } = Astro.props;
const { Content } = await render(protocol);
---

<BaseLayout title={`${protocol.data.title} - based.health`}>
    <main>
        <header class="mb-4">
            <h2 class="text-3xl font-bold text-stone-900">
                {protocol.data.title}
            </h2>
            <p class="text-sm text-stone-600 leading-relaxed mt-2">
                {protocol.data.summary}
            </p>
        </header>

        <section class="mb-8">
            <table class="w-full text-[10px] border border-stone-200 border-collapse ">
                <thead>
                    <tr>
                        <th colspan="2" class="bg-stone-100 p-2 text-left border-b border-stone-300 font-bold uppercase tracking-tight text-[10px] text-stone-700">
                            Protocol Snapshot
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-200">
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 w-1/3 text-[10px] uppercase text-stone-600">Difficulty</td>
                        <td class="p-2 capitalize text-stone-800">{protocol.data.difficulty}</td>
                    </tr>
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 text-[10px] uppercase text-stone-600">Financial Cost</td>
                        <td class="p-2 text-stone-800">{protocol.data.cost}</td>
                    </tr>
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 text-[10px] uppercase text-stone-600">Time</td>
                        <td class="p-2 text-stone-800">{protocol.data.timeCommitment}</td>
                    </tr>
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 text-[10px] uppercase text-stone-600">Frequency</td>
                        <td class="p-2 text-stone-800">{protocol.data.frequency}</td>
                    </tr>
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 text-[10px] uppercase text-stone-600">Impact</td>
                        <td class="p-2 capitalize text-stone-800">{protocol.data.impact}</td>
                    </tr>
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 text-[10px] uppercase text-stone-600">Evidence</td>
                        <td class="p-2 capitalize text-stone-800">{protocol.data.evidenceLevel}</td>
                    </tr>
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 text-[10px] uppercase text-stone-600">Risk</td>
                        <td class="p-2 capitalize text-stone-800">{protocol.data.riskLevel}</td>
                    </tr>
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 text-[10px] uppercase text-stone-600">Modify/Avoid</td>
                        <td class="p-2 text-stone-800">
                            <ul class="list-disc ml-4 space-y-1">
                                {protocol.data.contraindications.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </td>
                    </tr>
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 text-[10px] uppercase text-stone-600">Tags</td>
                        <td class="p-2">
                            <div class="flex flex-wrap gap-1">
                                {protocol.data.tags.map((tag) => (
                                    <span class="text-[10px] text-stone-500 bg-white px-1.5 border border-stone-200 font-mono">#{tag}</span>
                                ))}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="p-2 font-bold bg-stone-100 border-r border-stone-300 text-[10px] uppercase text-stone-600">Last Verified</td>
                        <td class="p-2 font-mono text-xs text-stone-800">{protocol.data.lastUpdated.toISOString().split("T")[0]}</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <article class="prose-container max-w-none">
            <Content />
        </article>

        <aside class="mt-8 border border-stone-200 bg-stone-50 p-3 text-xs leading-relaxed text-stone-600">
            This is a general education protocol, not personal medical advice. Stop if symptoms feel unsafe, and use qualified medical guidance for diagnosed conditions, medications, pregnancy, or high-risk situations.
        </aside>
    </main>
</BaseLayout>

<style is:global>
    @reference "../../styles/global.css";
  
    .prose-container {
      @apply text-stone-800 leading-relaxed;
    }
  
    /* --- 1. Lists --- */
    .prose-container ul { @apply !list-disc !list-outside !mb-6 !ml-6 !block; }
    .prose-container ol { @apply !list-decimal !list-outside !mb-6 !ml-6 !block; }
    .prose-container li { @apply !mb-2 !pl-1; }
  
    /* --- 2. IEEE Citations --- */
    .prose-container sup { @apply !relative !align-baseline !top-0; }
    .prose-container sup a { @apply !no-underline text-blue-700 font-mono text-sm mx-0.5; }
    .prose-container sup a::before { content: "["; }
    .prose-container sup a::after { content: "]"; }
  
    /* --- 3. Headers & Paragraphs --- */
    .prose-container h3 {
      @apply text-xl font-serif font-bold pb-1 mt-8 mb-2 text-stone-900;
    }
    .prose-container p { @apply mb-6; }
  
    /* --- 4. The References Section (Footnotes) --- */
    .prose-container .footnotes {
        @apply mt-0 pt-0 border-none; /* Remove default spacing/borders */
        counter-reset: footnotes-counter;
    }

    .prose-container .footnotes h2, 
    .prose-container .footnotes [data-footnote-label] {
        @apply !hidden;
    }

    .prose-container .footnotes ol { @apply !list-none !ml-0 !p-0 !mt-4; }
    .prose-container .footnotes li { @apply text-sm text-stone-600 mb-4 flex items-start gap-3; }

    .prose-container .footnotes li::before {
        counter-increment: footnotes-counter;
        content: "[" counter(footnotes-counter) "]";
        @apply font-mono text-stone-400 shrink-0 min-w-[25px] text-right;
    }

    .prose-container .footnotes li p { @apply !m-0 !inline; }
    .prose-container .data-footnote-backref { @apply !hidden; }
</style>
