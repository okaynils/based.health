---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const protocols = await getCollection('protocols');
  return protocols.map(protocol => ({
    params: { id: protocol.id },
    props: { protocol },
  }));
}

const { protocol } = Astro.props;
const { Content } = await render(protocol);
---

<BaseLayout title={`${protocol.data.title} - based.health`}>
    <main>
        <div class="mb-8 border-b border-stone-100 pb-6">
            <h1 class="text-4xl font-bold mb-4">{protocol.data.title}</h1>
            
            <div class="flex flex-wrap gap-4 text-[10px] uppercase tracking-widest font-bold">
                <span class="bg-stone-100 px-2 py-1">Difficulty: {protocol.data.difficulty}</span>
                <span class="bg-stone-100 px-2 py-1">Cost: {protocol.data.cost}</span>
                <span class="bg-stone-100 px-2 py-1">Time: {protocol.data.timeCommitment}</span>
            </div>
            
            <div class="mt-4 flex flex-wrap gap-2">
                {protocol.data.tags.map(tag => (
                    <span class="text-pink-800 text-xs italic">#{tag}</span>
                ))}
            </div>
        </div>

        <article class="prose prose-stone max-w-none">
            <Content />
        </article>
    </main>
</BaseLayout>