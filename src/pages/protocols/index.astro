---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProtocols = await getCollection('protocols');
// Sort alphabetically by default for a directory look
const sortedProtocols = allProtocols.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Protocols Directory - based.health">
    <main class="py-4">
        <header class="mb-3">
            <h2 class="text-2xl font-bold leading-none mb-2">
                Protocols Directory
            </h2>
            <p class="text-xs text-stone-600 leading-relaxed mb-2">
                Short implementation recipes with explicit risk, evidence, and contraindication notes.
            </p>
            
            <div class="relative group">
                <input 
                    type="text" 
                    id="protocol-search" 
                    placeholder="Search by title, tag, or goal..." 
                    class="w-full bg-stone-100 border border-stone-300 px-2.5 py-1.5 text-sm font-mono focus:outline-none focus:border-stone-800 focus:bg-white"
                />
            </div>
        </header>

        <div class="border-y border-stone-300">
            <table class="w-full text-left border-separate border-spacing-0" id="protocol-table">
                <thead>
                    <tr class="text-[11px] uppercase text-stone-600">
                        <th class="font-bold px-1 py-1.5 border-b border-stone-300 bg-stone-100">Name</th>
                        <th class="font-bold px-1 py-1.5 border-b border-stone-300 bg-stone-100 hidden md:table-cell">Evidence</th>
                        <th class="font-bold px-1 py-1.5 border-b border-stone-300 bg-stone-100 hidden md:table-cell">Risk</th>
                        <th class="font-bold px-1 py-1.5 border-b border-stone-300 bg-stone-100 text-right">Tags</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-200 bg-white">
                    {sortedProtocols.map(p => (
                        <tr class="protocol-row group relative hover:bg-[#ffffe8] cursor-pointer" 
                            data-title={p.data.title.toLowerCase()} 
                            data-summary={p.data.summary.toLowerCase()}
                            data-tags={p.data.tags.join(' ').toLowerCase()}>
                            <td class="px-1 py-2">
                                <a href={`/protocols/${p.id.replace(/\.md$/, '')}`} 
                                   class="text-[#0000ee] group-hover:underline block font-medium after:absolute after:inset-0 after:z-10">
                                    {p.data.title}
                                </a>
                                <p class="text-xs text-stone-500 leading-snug max-w-[28rem] pr-4">
                                    {p.data.summary}
                                </p>
                            </td>
                            <td class="px-1 py-2 text-stone-500 hidden md:table-cell">
                                <span class="text-xs font-mono">{p.data.evidenceLevel}</span>
                            </td>
                            <td class="px-1 py-2 text-stone-500 hidden md:table-cell">
                                <span class="text-xs font-mono">{p.data.riskLevel}</span>
                            </td>
                            <td class="px-1 py-2 text-right">
                                <div class="flex gap-1 justify-end flex-wrap relative z-20">
                                    {p.data.starterKit && (
                                        <span class="meta-chip bg-[#eaf5df] text-lime-800">
                                            starter
                                        </span>
                                    )}
                                    {p.data.tags.map(tag => (
                                        <span class="meta-chip">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
            
            <div id="no-results" class="hidden p-12 text-center text-stone-400 italic text-sm border-t border-stone-300">
                No matching protocols found.
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    const searchInput = document.getElementById('protocol-search') as HTMLInputElement;
    const rows = document.querySelectorAll('.protocol-row');
    const noResults = document.getElementById('no-results');

    searchInput?.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase();
        let hasMatches = false;

        rows.forEach(row => {
            const title = row.getAttribute('data-title') || '';
            const summary = row.getAttribute('data-summary') || '';
            const tags = row.getAttribute('data-tags') || '';
            
            if (title.includes(query) || summary.includes(query) || tags.includes(query)) {
                (row as HTMLElement).style.display = '';
                hasMatches = true;
            } else {
                (row as HTMLElement).style.display = 'none';
            }
        });

        // Show/Hide empty state
        if (noResults) {
            noResults.style.display = hasMatches ? 'none' : 'block';
        }
    });
</script>
